{
  "name": "pi-durable-subagents-extension",
  "version": "0.1.0",
  "description": "Persistent background agents for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghita/durable-subagents.git"
  },
  "homepage": "https://github.com/ghita/durable-subagents#readme",
  "bugs": {
    "url": "https://github.com/ghita/durable-subagents/issues"
  },
  "files": [
    "src",
    "docs/images",
    "README.md",
    "GLOSSARY.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "durable"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:model-bridge": "node --experimental-strip-types test/model-bridge-smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^22.19.19",
    "typebox": "1.4.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "^1.5.2",
    "yaml": "^2.9.1"
  }
}
