{
  "name": "pi-durable-subagents-extension",
  "version": "0.2.0",
  "description": "Persistent background agents for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghita/durable-subagents-pi-extension.git"
  },
  "homepage": "https://github.com/ghita/durable-subagents-pi-extension#readme",
  "bugs": {
    "url": "https://github.com/ghita/durable-subagents-pi-extension/issues"
  },
  "files": [
    "src",
    "presets",
    "docs/agents/agent-files.md",
    "docs/images",
    "README.md",
    "GLOSSARY.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "durable"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:model-bridge": "node --experimental-strip-types test/model-bridge-smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@opentelemetry/otlp-transformer": "^0.57.2",
    "@types/node": "^22.19.19",
    "typebox": "1.4.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.57.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  }
}
